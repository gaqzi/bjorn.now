#!/bin/bash

set -e

usage() {
    cat <<HELP
Usage: script/new [OPTIONS] <content-type> [slug-or-content]

Create new content. For scraps, the second argument is the content itself.
For all other types, it's the slug.

Options:
  --tags <t1,t2,...>   Comma-separated tags (validated against data/tags.yaml)
  --series <name>      Assign to a series (validated against content/series/)
  --location <place>   Override the default location
  --commit             Commit the new file immediately
  --edit               Open the file in your editor
  --help               Show this help

Content types: $(ls archetypes/ | sed 's/\.md$//' | grep -v -E '^(archive|series)$' | tr '\n' ' ')

Examples:
  script/new scrap "Some quick thought"
  script/new scrap "Tagged thought" --tags 3d-printing,funny --commit
  script/new til my-slug --tags golang --series my-series
HELP
    exit 0
}

# Parse arguments
EDIT_FLAG=false
COMMIT_FLAG=false
SERIES_VALUE=""
LOCATION_VALUE=""
TAGS_VALUE=""
ARGS=()

for arg in "$@"; do
    if [ "$arg" = "--help" ]; then
        usage
    elif [ "$arg" = "--edit" ]; then
        EDIT_FLAG=true
    elif [ "$arg" = "--commit" ]; then
        COMMIT_FLAG=true
    elif [ "$arg" = "--tags" ]; then
        EXPECT_TAGS_VALUE=true
    elif [[ "$arg" == --tags=* ]]; then
        TAGS_VALUE="${arg#--tags=}"
    elif [ "${EXPECT_TAGS_VALUE:-false}" = true ]; then
        TAGS_VALUE="$arg"
        EXPECT_TAGS_VALUE=false
    elif [ "$arg" = "--series" ]; then
        # Next argument will be the series value
        EXPECT_SERIES_VALUE=true
    elif [[ "$arg" == --series=* ]]; then
        # Handle --series=value format
        SERIES_VALUE="${arg#--series=}"
    elif [ "$arg" = "--location" ]; then
        # Next argument will be the location value
        EXPECT_LOCATION_VALUE=true
    elif [[ "$arg" == --location=* ]]; then
        # Handle --location=value format
        LOCATION_VALUE="${arg#--location=}"
    elif [ "${EXPECT_SERIES_VALUE:-false}" = true ]; then
        # This is the series value following --series
        SERIES_VALUE="$arg"
        EXPECT_SERIES_VALUE=false
    elif [ "${EXPECT_LOCATION_VALUE:-false}" = true ]; then
        # This is the location value following --location
        LOCATION_VALUE="$arg"
        EXPECT_LOCATION_VALUE=false
    else
        ARGS+=("$arg")
    fi
done

# Get arguments (after filtering out --edit and --series flags)
CONTENT_TYPE=${ARGS[0]}
SLUG_OR_CONTENT=${ARGS[1]}

# Get valid content types from archetypes directory
get_valid_types() {
    ls archetypes/ | sed 's/\.md$//' | grep -v -E '^(archive|series)$' || true
}

# Validate content type
validate_type() {
    local type=$1
    local valid_types
    valid_types=$(get_valid_types)
    
    if ! echo "$valid_types" | grep -q "^${type}$"; then
        echo "Invalid content type: $type" >&2
        echo "Valid types: $(echo "$valid_types" | tr '\n' ' ')" >&2
        exit 1
    fi
}

# Get valid series from content/series directory
get_valid_series() {
    ls content/series/ 2>/dev/null | grep -v '^\.$' | grep -v '^\.\.$' || true
}

# Validate series
validate_series() {
    local series=$1
    local valid_series
    valid_series=$(get_valid_series)

    if ! echo "$valid_series" | grep -q "^${series}$"; then
        echo "Invalid series: $series" >&2
        echo "Valid series: $(echo "$valid_series" | tr '\n' ' ')" >&2
        exit 1
    fi
}

# Get valid tags from data/tags.yaml
get_valid_tags() {
    grep -E '^[a-z0-9]' data/tags.yaml | sed 's/:.*$//' || true
}

# Validate tags
validate_tags() {
    local tags_csv=$1
    local valid_tags
    valid_tags=$(get_valid_tags)

    IFS=',' read -ra tags <<< "$tags_csv"
    for tag in "${tags[@]}"; do
        if ! echo "$valid_tags" | grep -q "^${tag}$"; then
            echo "Invalid tag: $tag" >&2
            echo "Valid tags: $(echo "$valid_tags" | tr '\n' ' ')" >&2
            exit 1
        fi
    done
}

# Get content type
if [ -z "$CONTENT_TYPE" ]; then
    valid_types=$(get_valid_types)
    CONTENT_TYPE=$(echo "$valid_types" | gum choose --header="Select content type:")
else
    validate_type "$CONTENT_TYPE"
fi

# Validate series if provided
if [ -n "$SERIES_VALUE" ]; then
    validate_series "$SERIES_VALUE"
fi

# Validate tags if provided
if [ -n "$TAGS_VALUE" ]; then
    validate_tags "$TAGS_VALUE"
fi

# Generate timestamps
current_date=$(date +%Y-%m-%d)
current_datetime=$(date +%Y-%m-%dT%H%M%S)

# Handle different content types
case "$CONTENT_TYPE" in
    scrap)
        # For scrap, use datetime format and handle content differently
        filename="content/scrap/${current_datetime}.md"
        
        if [ -z "$SLUG_OR_CONTENT" ]; then
            content=$(gum input --header="Enter content for scrap:")
        else
            content="$SLUG_OR_CONTENT"
        fi
        
        # Create the file with hugo
        hugo new "$filename"
        
        # Append the content to the file
        echo "$content" >> "$filename"
        ;;
    *)
        # For all other types, use date format with slug
        if [ -z "$SLUG_OR_CONTENT" ]; then
            slug=$(gum input --header="Enter slug for $CONTENT_TYPE:")
        else
            slug="$SLUG_OR_CONTENT"
        fi
        
        filename="content/${CONTENT_TYPE}/${current_date}-${slug}.md"
        
        # Create the file with hugo
        hugo new "$filename"
        ;;
esac

# Update tags field if --tags flag was provided
if [ -n "$TAGS_VALUE" ]; then
    IFS=',' read -ra tags <<< "$TAGS_VALUE"
    tags_yaml=""
    for i in "${!tags[@]}"; do
        if [ "$i" -gt 0 ]; then
            tags_yaml+=", "
        fi
        tags_yaml+="'${tags[$i]}'"
    done
    sed -i '' "s/tags: \[\]/tags: [$tags_yaml]/" "$filename"
fi

# Update series field if --series flag was provided
if [ -n "$SERIES_VALUE" ]; then
    sed -i '' "s/series: \[\]/series: ['$SERIES_VALUE']/" "$filename"
fi

# Update location field if --location flag was provided
if [ -n "$LOCATION_VALUE" ]; then
    sed -i '' "s/location: .*$/location: $LOCATION_VALUE/" "$filename"
fi

echo "Created: $filename"
git add "$filename"

# Commit the file if --commit flag was provided
if [ "$COMMIT_FLAG" = true ]; then
    commit_filename=$(basename "$filename")
    git commit -m "Add $commit_filename"
fi

# Open in editor if --edit flag was provided
if [ "$EDIT_FLAG" = true ]; then
    idea --line 10000 "$filename"
fi
