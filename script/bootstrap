#!/bin/bash

function isClaudeCodeWeb() {
  [[ -n "${CLAUDE_CODE_REMOTE}" ]]
}

function installHugoDirectly() {
  local hugo_version=$(grep '^gohugo' .tool-versions | awk '{print $2}')
  local install_dir="$HOME/.local/bin"

  if [[ -z "${hugo_version}" ]]; then
    echo "Failed to read Hugo version from .tool-versions" >&2
    return 1
  fi

  if command -v hugo &> /dev/null; then
    echo "Hugo already installed: $(hugo version)"
    return 0
  fi

  echo "Installing Hugo ${hugo_version} directly..."
  mkdir -p "${install_dir}"

  local tmp_dir=$(mktemp -d)
  cd "${tmp_dir}" || return 1

  wget -q "https://github.com/gohugoio/hugo/releases/download/v${hugo_version}/hugo_extended_${hugo_version}_linux-amd64.tar.gz" || {
    echo "Failed to download Hugo" >&2
    return 1
  }

  tar -xzf "hugo_extended_${hugo_version}_linux-amd64.tar.gz" || {
    echo "Failed to extract Hugo" >&2
    return 1
  }

  mv hugo "${install_dir}/" || {
    echo "Failed to move Hugo to ${install_dir}" >&2
    return 1
  }

  cd - > /dev/null
  rm -rf "${tmp_dir}"

  export PATH="${install_dir}:${PATH}"
  echo "Hugo installed successfully: $(hugo version)"
}

function installAsdf() {
  if which -s asdf ; then
    return
  fi

  echo "asdf not installed, will try to install with homebrew"
  if ! brew install asdf; then
    echo "Failed to install asdf" >&2
    exit 1
  fi

  bash_line=$(brew info asdf | grep asdf/libexec/asdf.sh)
  if [ -z "$bash_line" ]; then
    echo "Didn't find the shell install script for bash/zsh to auto-install asdf in your shell" >&2
    echo "Run 'brew info asdf' to see how" >&2
    exit 1
  fi

  echo "Auto-installing asdf shell setup in:"
  echo "    - $HOME/.bashrc for bash"
  echo "$bash_line" >> $HOME/.bashrc

  echo "    - $HOME/.zshrc for zsh"
  echo "$bash_line" >> $HOME/.zshrc

  echo "Restart your shell for changes to take effect"
  exit 1
}

function installAsdfPlugins() {
  cat .tool-versions | cut -d' ' -f1 | while IFS= read -r plugin; do
    asdf plugin add $plugin || exit 1
  done
}

function installUv() {
  if command -v uv &> /dev/null; then
    echo "uv already installed: $(uv --version)"
    return
  fi

  echo "uv not installed, will try to install with pip"
  if ! pip install uv; then
    echo "Failed to install uv" >&2
    exit 1
  fi
}

function installXsv() {
  if command -v xsv &> /dev/null; then
    return
  fi

  if isClaudeCodeWeb; then
    echo "xsv not available in Claude Code Web, skipping..."
    echo "Note: xsv is optional for CSV processing"
    return 0
  fi

  echo "xsv not installed, will try to install with homebrew"
  if ! brew install xsv; then
    echo "Failed to install xsv" >&2
    exit 1
  fi
}

function installPreCommitHook() {
  local hook_path=".git/hooks/pre-commit"

  if [ -f "$hook_path" ]; then
    echo "Pre-commit hook already exists, skipping installation"
    return
  fi

  echo "Installing pre-commit hook to run linting checks"

  cat > "$hook_path" << 'EOF'
#!/bin/bash
# Pre-commit hook to run linting and tests

script/lint &&
  script/test
EOF

  chmod +x "$hook_path"
  echo "Pre-commit hook installed successfully"
}

## Check environment and install tools accordingly
if isClaudeCodeWeb; then
  echo "Running in Claude Code Web environment, using direct installation"
  echo "Install Hugo directly"
  installHugoDirectly || exit 1
else
  ## Check that homebrew is installed
  if ! which -s brew ; then
    echo "Homebrew not installed, please install it and then run again" >&2
    echo "    https://brew.sh/" >&2
    exit 1
  fi

  ## Install asdf if needed, then all asdf plugins, and all tools in asdf
  echo "Install tools at the correct version"
  installAsdf &&
    installAsdfPlugins &&
    asdf install
fi

## Install uv and sync project dependencies
echo "Install uv and sync project dependencies"
installUv &&
  uv sync --group dev

## Install xsv for CSV processing
echo "Install xsv for CSV processing"
installXsv

## Install pre-commit hook
installPreCommitHook
